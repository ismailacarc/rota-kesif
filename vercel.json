{
  "version": 2,
  "builds": [
    { "src": "api/*.py",   "use": "@vercel/python" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "style.css",  "use": "@vercel/static" },
    { "src": "app.js",     "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/oner", "dest": "/api/oner.py" },
    { "src": "/api/plan", "dest": "/api/plan.py" },
    { "src": "/",         "dest": "/index.html" },
    { "src": "/(.*)",     "dest": "/$1" }
  ]
}
